# Copy to .env to override defaults (docker compose reads .env automatically).
APP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_METRICS_PORT=8889
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_ENABLED=true
# Fault defaults applied at app start (normally toggle at runtime instead)
FAULT_LATENCY_MS=0
FAULT_CPU=false
FAULT_ERROR_RATE=0
CPU_BURN_THREADS=2
BASE_ERROR_RATE=0.002
# k6 load
LOAD_DURATION=10m
LOAD_RPS=20
LOAD_WAVE_PERIOD_S=300
